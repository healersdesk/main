{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/desk",
      "has": [
        {
          "type": "host",
          "value": "www.healersdesk.com"
        }
      ],
      "destination": "https://app.healersdesk.com/desk",
      "permanent": false
    },
    {
      "source": "/desk/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.healersdesk.com"
        }
      ],
      "destination": "https://app.healersdesk.com/desk/:path*",
      "permanent": false
    },
    {
      "source": "/intake",
      "has": [
        {
          "type": "host",
          "value": "www.healersdesk.com"
        }
      ],
      "destination": "https://app.healersdesk.com/intake",
      "permanent": false
    },
    {
      "source": "/intake/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.healersdesk.com"
        }
      ],
      "destination": "https://app.healersdesk.com/intake/:path*",
      "permanent": false
    },
    {
      "source": "/report",
      "has": [
        {
          "type": "host",
          "value": "www.healersdesk.com"
        }
      ],
      "destination": "https://app.healersdesk.com/report",
      "permanent": false
    },
    {
      "source": "/r/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.healersdesk.com"
        }
      ],
      "destination": "https://app.healersdesk.com/r/:path*",
      "permanent": false
    },
    {
      "source": "/i/:slug",
      "has": [
        {
          "type": "host",
          "value": "www.healersdesk.com"
        }
      ],
      "destination": "https://app.healersdesk.com/intake/:slug",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.healersdesk.com"
        }
      ],
      "destination": "/desk",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/desk",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "/desk",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/policy#privacy",
      "permanent": false
    },
    {
      "source": "/terms",
      "destination": "/policy#terms",
      "permanent": false
    },
    {
      "source": "/refund",
      "destination": "/policy#refund",
      "permanent": false
    },
    {
      "source": "/i/:slug",
      "destination": "/intake/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/intake/:slug",
      "destination": "/intake"
    },
    {
      "source": "/r/:slug/:sub",
      "destination": "/report"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/desk-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/desk"
        }
      ]
    },
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  }
}